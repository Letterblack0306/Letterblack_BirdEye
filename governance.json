{
  "allowed_read_paths": [
    "."
  ],
  "forbidden_globs": [
    "**/.git/**",
    "**/.svn/**",
    "**/.hg/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/venv/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/.cache/**",
    "**/coverage/**",
    "**/.nyc_output/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/target/**",
    "**/tmp/**",
    "**/temp/**",
    "**/*.zxp",
    "**/*.zip",
    "**/*.7z",
    "**/*.rar",
    "**/*.tar",
    "**/*.gz",
    "**/*.exe",
    "**/*.msi",
    "**/*.dmg",
    "**/*.dll",
    "**/*.so",
    "**/.env",
    "**/.env.*",
    "**/credentials*",
    "**/secrets*",
    "**/workspace.db",
    "**/workspace.db-wal",
    "**/workspace.db-shm",
    "**/trace_progress.json",
    "**/workspace_trace.json",
    "**/last_search.json"
  ]
}
