{
  "allowed_read_paths": [
    "."
  ],
  "allowed_write_paths": [],
  "forbidden_globs": [
    "**/.git/**",
    "**/.svn/**",
    "**/.hg/**",
    "**/.idea/**",
    "**/.vscode/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/venv/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/.cache/**",
    "**/coverage/**",
    "**/.nyc_output/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/target/**",
    "**/tmp/**",
    "**/temp/**",
    "**/*.zxp",
    "**/*.zip",
    "**/*.7z",
    "**/*.rar",
    "**/*.tar",
    "**/*.gz",
    "**/*.exe",
    "**/*.msi",
    "**/*.dmg",
    "**/*.dll",
    "**/*.so",
    "**/*.p12",
    "**/*.pfx",
    "**/*.key",
    "**/*.pem",
    "**/.env",
    "**/.env.*",
    "**/credentials*",
    "**/secrets*",
    "**/_FILTER/**",
    "**/workspace_trace.json",
    "**/workspace_trace.partial.jsonl",
    "**/trace_progress.json",
    "**/hash_cache.json",
    "**/last_search.json",
    "**/workspace.db",
    "**/workspace.db-wal",
    "**/workspace.db-shm"
  ],
  "required_files": [],
  "allowed_commands": [
    ["git", "status"],
    ["git", "diff"],
    ["git", "log"],
    ["git", "show"],
    ["git", "branch"],
    ["git", "rev-parse"],
    ["git", "ls-files"],
    ["git", "grep"],
    ["git", "fetch"],
    ["node", "--version"],
    ["npm.cmd", "test"],
    ["npm.cmd", "run", "test"],
    ["npm.cmd", "run", "lint"],
    ["npm.cmd", "run", "check"],
    ["npm.cmd", "run", "build"],
    ["python", "--version"],
    ["python", "-m", "pytest"],
    ["python", "-m", "unittest"]
  ],
  "mutation_commands": [
    ["git", "add"],
    ["git", "commit"],
    ["npm.cmd", "install"],
    ["npm.cmd", "ci"],
    ["python", "-m", "pip", "install"]
  ],
  "blocked_commands": [
    "powershell",
    "pwsh",
    "cmd /c",
    "cmd /k",
    "bash -c",
    "sh -c",
    "wsl",
    "Set-ExecutionPolicy",
    "EncodedCommand",
    "reg add",
    "reg delete",
    "diskpart",
    "bcdedit",
    "format",
    "shutdown",
    "restart-computer",
    "net stop",
    "net start",
    "sc delete",
    "git reset --hard",
    "git clean -fd",
    "git clean -fdx",
    "git checkout -- .",
    "git restore .",
    "git restore --source",
    "git push --force",
    "git push -f",
    "git branch -D",
    "git reflog expire"
  ],
  "max_changed_files": 0,
  "max_patch_bytes": 0,
  "require_clean_base_hash": true,
  "store_only_verified_repairs": true
}