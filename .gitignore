# Python runtime artifacts
__pycache__/
*.py[cod]
*$py.class

# Runtime index / evidence state (regenerated by `python agent.py trace`)
state/

# Memory's generated historical-source indexes are owned by BirdEye state
state/memory-indexes/
state/vectors/

# Generated local database/index artifacts and migration backups
*.db
*.db-*
*.sqlite
*.sqlite3
*.bak
eye_Databa/
archive/

# Local-only configuration
config.json

# Local-only private bridge config (machine-specific credentials)
bridge/bridge.config.json
