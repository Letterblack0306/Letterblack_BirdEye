{
  "machineId": "dev-main",
  "pollSeconds": 45,
  "repository": "Letterblack0306/Letterblack_BirdEye",
  "branch": "runtime/dev-main",
  "tokenEnv": "BIRDEYE_GITHUB_TOKEN",
  "workspaces": {
    "access-browser-agent": {
      "root": "G:\\Developments\\46_Accecc_Browser_Agent",
      "database": "C:\\MCP Local\\Letterblack_BirdEye\\state\\workspace.db",
      "validationProfiles": {
        "default": [
          ["npm.cmd", "run", "check"]
        ],
        "audit": [
          ["npm.cmd", "run", "check"],
          ["npm.cmd", "run", "audit:full"]
        ]
      },
      "artifactRoots": {
        "browser-screenshots": {
          "enabled": false,
          "path": "",
          "patterns": ["*.png", "*.jpg", "*.jpeg", "*.webp"],
          "maxFileBytes": 10485760,
          "publish": false
        }
      }
    },
    "brew": {
      "root": "G:\\Developments\\38_Brew_Creative_Agent",
      "database": "C:\\MCP Local\\Letterblack_BirdEye\\state\\workspace.db",
      "validationProfiles": {
        "default": [
          ["npm.cmd", "run", "check"]
        ]
      }
    }
  },
  "activityEvidence": {
    "enabled": true,
    "maxEvents": 80,
    "maxFilesPerSource": 12,
    "sources": {
      "codex": {
        "root": "%USERPROFILE%\\.codex",
        "patterns": ["sessions/**/*.jsonl", "history.jsonl"]
      },
      "antigravity": {
        "root": "%USERPROFILE%\\.gemini\\antigravity-cli",
        "pattern": "log/cli-*.log"
      }
    }
  }
}