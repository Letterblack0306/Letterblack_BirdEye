{
  "manifest_version": 3,
  "name": "BirdEye Browser Relay",
  "version": "0.3.2",
  "description": "Local browser relay for BirdEye without Chrome remote debugging.",
  "permissions": [
    "tabs",
    "alarms",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "browser_heartbeat.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "BirdEye Browser Relay"
  }
}